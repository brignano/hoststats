{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoststats",
  "compatibility_date": "2026-08-23",

  // Static Next.js export in ./out. The one exception is /api/calendar,
  // which fetches a host's Airbnb calendar feed (Airbnb sends no CORS
  // headers, so the browser can't). Everything else never touches the Worker.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },

  "observability": {
    "enabled": true,
  },
}
